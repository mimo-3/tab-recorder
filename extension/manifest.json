{
  "manifest_version": 3,
  "name": "Tab Recorder",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "management",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Recorder"
  }
}
